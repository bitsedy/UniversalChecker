# ==============================================================================
# AggreGate / CheckerPay Ghana - Environment Configuration
# High-Concurrency WAEC / CSSPS Voucher Gateway & Educational Pathway Advisor
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION & DATABASE
# ------------------------------------------------------------------------------
PORT=8000
CHECKER_DB_PATH=checker_platform/checker.db
# Random cryptographic secret for signing admin sessions & tokens (generate with: openssl rand -hex 32)
SESSION_SECRET=change-this-to-a-secure-random-32-char-string
# Set to 'true' in production when running behind HTTPS/TLS
COOKIE_SECURE=false

# ------------------------------------------------------------------------------
# 2. PAYSTACK PAYMENT GATEWAY (https://dashboard.paystack.com/)
# ------------------------------------------------------------------------------
# Replace with your live keys once your Paystack account is activated
PAYSTACK_PUBLIC_KEY=pk_test_sample_ghana_waec
PAYSTACK_SECRET_KEY=sk_test_sample_ghana_waec_secret

# ------------------------------------------------------------------------------
# 3. EXECUTIVE ADMIN PORTAL ACCESS & STEALTH GATE
# ------------------------------------------------------------------------------
ADMIN_USERNAME=admin
# ADMIN_PASSWORD=  # Optional: Leave blank to manage via Admin Dashboard / Database
# Secret gate key appended to URL (?gate=...) to unlock admin access (Stealth 404)
ADMIN_GATE_KEY=ghana2026_gate
# Comma-separated list of allowed admin IPs (bypass gate checks)
ADMIN_ALLOWED_IPS=127.0.0.1,::1

# ------------------------------------------------------------------------------
# 4. SMS GATEWAY INTEGRATION (Arkesel / mNotify / Hubtel)
# ------------------------------------------------------------------------------
SMS_SENDER_ID=CHECKER_GH
ARKESEL_API_KEY=
MNOTIFY_API_KEY=

# ------------------------------------------------------------------------------
# 5. CUSTOMER SUPPORT & MERCHANT DESK
# ------------------------------------------------------------------------------
SUPPORT_PHONE=+233 24 000 0000
SUPPORT_WHATSAPP=233509512942

# ------------------------------------------------------------------------------
# 6. PRODUCT RETAIL PRICING (GHS - GHANA CEDIS)
# ------------------------------------------------------------------------------
PRICE_WASSCE=22.00
PRICE_BECE=18.00
PRICE_CSSPS=15.00

# ------------------------------------------------------------------------------
# 7. EDUCATIONAL PATHWAY ADVISOR PRICING (DECOY EFFECT MODEL)
# ------------------------------------------------------------------------------
PRICE_ADVISORY_BASIC=6.00
PRICE_ADVISORY_DECOY=12.00
PRICE_ADVISORY_HERO=15.00

# ------------------------------------------------------------------------------
# 8. INVENTORY DISPENSING MODE ('BATCH' or 'DEMO_GENERATE')
# ------------------------------------------------------------------------------
INVENTORY_MODE=BATCH
